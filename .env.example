# OpenAI API Configuration (for summarization)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# AssemblyAI API Configuration (for speech-to-text)
# Get your API key from: https://www.assemblyai.com/dashboard/signup
# Sign up for free: First 5 hours are free, then $0.00025/second ($0.015/min)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# Speech-to-Text Provider Selection
# Options: 'assemblyai' (best quality, fast), 'openai' (also good), 'local' (free, slow)
STT_PROVIDER=assemblyai

# AssemblyAI Options
# Enable speaker identification (who said what)
ENABLE_SPEAKER_LABELS=false

# Language code (e.g., 'en', 'es', 'fr', 'vi', etc.)
# Leave empty or set to 'en' for auto-detection
LANGUAGE_CODE=en

# Flask Secret Key (generate a random string for production)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=supersecretkey
