# OpenAI API Configuration (for summarization and chatbot)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# AssemblyAI API Configuration (for audio transcription)
# Get free API key: https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# AssemblyAI Transcription Options
ENABLE_SPEAKER_LABELS=false
LANGUAGE_CODE=en

# Flask Secret Key
SECRET_KEY=your-secret-key-here

# ChromaDB Configuration
# Mode: 'local' or 'cloud'
CHROMA_MODE=local

# For cloud mode (Self-hosted ChromaDB HTTP Server):
# Step 1: Install server: pip install chromadb
# Step 2: Start server: chroma run --host 0.0.0.0 --port 8000
# Step 3: Set CHROMA_MODE=cloud and update host/port below
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ChromaDB Telemetry
ANONYMIZED_TELEMETRY=False
